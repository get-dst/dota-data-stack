# Where the data lands. duckdb = a local file under data/ (the default, no accounts
# needed); motherduck = one MotherDuck database (MOTHERDUCK_TOKEN, read-write);
# postgres = the DATABASE_URL below.
DSTACK_TARGET=duckdb
MOTHERDUCK_DATABASE=dota
MOTHERDUCK_TOKEN=
DSTACK_DUCKDB_PATH=data/dota.duckdb
# postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# How far back the pro-match list reaches, and how many match-detail calls one run
# may spend. OpenDota's free tier is 60 calls/min and 3000/day; a run of 2500 leaves
# room for the dimensions. A key lifts both limits.
DOTA_SINCE_DAYS=90
DOTA_MAX_DETAIL_CALLS=2500
# Pages of 100 public matches sampled per run (a run of 60 ≈ 6 000 matches).
DOTA_PUBLIC_PAGES=60
# Paid calls (a hundredth of a cent each) ride only the match-detail fetch; everything
# else is keyless and free. The cap is enforced from the api_usage table. 90 000 ≈ $9.
OPENDOTA_API_KEY=
DOTA_PAID_CALLS_MONTH=90000
# Public matches older than this are deleted after each run; the marts keep the rollups.
DOTA_PUBLIC_KEEP_DAYS=60
