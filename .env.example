# Where the data lands. duckdb = a local file under data/ (the default, no accounts
# needed); postgres = the DATABASE_URL below (Aiven for PostgreSQL in the showcase).
DSTACK_TARGET=duckdb
DSTACK_DUCKDB_PATH=data/dota.duckdb
# postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# How far back the pro-match list reaches, and how many match-detail calls one run
# may spend. OpenDota's free tier is 60 calls/min and 3000/day; a run of 2500 leaves
# room for the dimensions. A key lifts both limits.
DOTA_SINCE_DAYS=90
DOTA_MAX_DETAIL_CALLS=2500
OPENDOTA_API_KEY=
