# The hosted demo's env contract. Names only: fill a copy (deploy/.env, gitignored) on the
# VM, or put the secrets in Secret Manager for Cloud Run (cloudrun.sh names them).
# Comments stay on their own lines: compose reads a trailing one as part of the value.

# dst's own state (Postgres with pgvector). DST_SECRET_KEY from `dst secret`; losing it
# orphans the stored warehouse token.
POSTGRES_PASSWORD=
DST_APP_DB_PASSWORD=
DST_SECRET_KEY=

# Where it is served (e.g. demo.dataservetool.com), and the dst release the demo layer
# (deploy/Dockerfile) builds on.
DEMO_DOMAIN=
DST_BASE_IMAGE=ghcr.io/get-dst/dst:0.5.7

# Models: DeepSeek writes prose and raw SQL, Jev makes the typed decisions. Referenced by
# name from DST_PROVIDERS in docker-compose.yml, never inlined there.
DST_API_KEY_DEEPSEEK=
DST_API_KEY_JEV=

# The warehouse: a MotherDuck READ-SCALING token for md:dota. serve/dst.yaml declares
# secret_env DST_API_KEY_WAREHOUSE; `dst apply` resolves it on the server, probes it and
# stores it encrypted.
DST_API_KEY_WAREHOUSE=

# The name the demo answers to: on the sign-in and consent pages, as the MCP server's
# name, and in the manual Claude reads ("ask roshan which hero…").
DST_INSTANCE_NAME=roshan

# Sign-in: the pk_live_ key of the Clerk production instance.
DST_CLERK_PUBLISHABLE_KEY=

# Demo mode. DST_DEMO_ORG_ID is printed by `dst bootstrap --org demo` (empty on the first
# boot). DST_DEMO_KEY_DAYS is the life of a key minted on /demo. DST_DAILY_REQUEST_CAP is
# governed answers per rolling 24 h for the whole demo; 0 means NO cap.
DST_DEMO_ORG_ID=
DST_DEMO_KEY_DAYS=7
DST_DAILY_REQUEST_CAP=2000
